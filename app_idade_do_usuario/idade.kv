<MainWidget>:
    orientation: "vertical"
    padding: "10dp"
    spacing: "10dp"
    size_hint: 0.9, 0.9
    pos_hint: {"center_x": 0.5, "center_y": 0.5}

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: "10dp"
            spacing: "10dp"
            
            Label:
                text:'App de Idades'
                font_size: "28sp"
                bold: True
                halign: "center"
                valign: "middle"
                size_hint_y: None
                height: "40dp"  # Altura reduzida (era: self.texture_size[1] + "20dp")
                color: 0, 0.55, 1, 1
                text_size: self.width, None

    TextInput:
        id: campo_nome
        hint_text: "Digite seu nome"
        multiline: False
        size_hint_y: None
        height: 40

    # instrução de exemplo para o nome
    Label:
        text: "Ex.: João da Silva"
        font_size: 14
        color: 0.3,0.3,0.3,1
        size_hint_y: None
        height: 20

    TextInput:
        id: campo_idade
        hint_text: "Digite sua idade"
        input_filter: "int"  # apenas números
        multiline: False
        size_hint_y: None
        height: 40

    # instrução de exemplo para a idade
    Label:
        text: "Apenas números de 0 a 120"
        font_size: 14
        color: 0.3,0.3,0.3,1
        size_hint_y: None
        height: 20

    Button:
        text: "Enviar"
        font_size: 25
        size_hint_y: None
        height: 50
        background_normal: ""              
        background_color: 0, 0.55, 1, 1    
        color: 1, 1, 1, 1                  
        on_press: root.verificar_idade()

    Label:
        id: label_resultado
        text: root.mensagem
        halign: "center"
        valign: "middle"
        font_size: 20
        text_size: self.size
        color: 0, 0.55, 1, 1
        size_hint_y: None
        height: 40

    Label:
        text: "Histórico:"
        font_size: 18
        bold: True
        halign: "center"
        size_hint_y: None
        height: 30
        color: 0, 0.3, 0.6, 1

    ScrollView:
        size_hint_y: None
        height: 150
        
        Label:
            id: label_historico
            text: ""
            font_size: 16
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
            color: 0.2, 0.2, 0.2, 1
