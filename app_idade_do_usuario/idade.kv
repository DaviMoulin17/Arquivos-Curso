<MainWidget>:
    orientation: "vertical"
    padding: 20
    spacing: 15

    size_hint: None, None
    size: 700, 400
    pos_hint: {"center_x": 0.5, "center_y": 0.5}

    Label:
        text:'App de Idades'
        font_size: 32
        bold: True
        halign: "center"
        valign: "middle"
        size_hint_y: None
        height: 60
        color: 0, 0.55, 1, 1
        text_size: self.size

    TextInput:
        id: campo_nome
        hint_text: "Digite seu nome"
        multiline: False
        size_hint_y: None
        height: 40

    # instrução de exemplo para o nome
    Label:
        text: "Ex.: João da Silva"
        font_size: 14
        color: 0.3,0.3,0.3,1
        size_hint_y: None
        height: 20

    TextInput:
        id: campo_idade
        hint_text: "Digite sua idade"
        input_filter: "int"  # apenas números
        multiline: False
        size_hint_y: None
        height: 40

    # instrução de exemplo para a idade
    Label:
        text: "Apenas números de 0 a 120"
        font_size: 14
        color: 0.3,0.3,0.3,1
        size_hint_y: None
        height: 20

    Button:
        text: "Enviar"
        font_size: 25
        size_hint_y: None
        height: 50
        background_normal: ""              
        background_color: 0, 0.55, 1, 1    
        color: 1, 1, 1, 1                  
        on_press: root.verificar_idade()

    Label:
        id: label_resultado
        text: root.mensagem
        halign: "center"
        valign: "middle"
        text: root.mensagem 
        font_size: 20
        text_size: self.size
        color: 0, 0.55, 1, 1

        canvas.before:
            Color:
                rgba: 0.9, 0.9, 0.9, 1
            Rectangle:
                pos: self.pos
                size: self.size
